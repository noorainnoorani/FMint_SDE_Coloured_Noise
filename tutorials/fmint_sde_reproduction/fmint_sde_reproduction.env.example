# Copy this file to fmint_sde_reproduction.env and edit it for your machine.
# The runner sources that local file automatically when present.

# Repo and output roots.
export REPO_ROOT="/path/to/FMint_SDE_Coloured_Noise"
export DATA_ROOT="$REPO_ROOT/tutorials/fmint_sde_reproduction/data"
export LOG_ROOT="$REPO_ROOT/tutorials/fmint_sde_reproduction/logs"
export ANALYSIS_ROOT="$REPO_ROOT/tutorials/fmint_sde_reproduction/results"

# Runtime environment.
export PYTHON_BIN="python3"
export GPU="0"
export HF_HOME="$HOME/.cache/huggingface"
export LD_LIBRARY_PATH="${CONDA_PREFIX:-}/lib:${LD_LIBRARY_PATH:-}"

# Existing run.py writes checkpoints/results under this hard-coded root:
#   /export/nnoorani/FMint_SDE_Coloured_Noise/save/${RUN_USER}/...
# Do not edit existing run.py for this tutorial. Create this path or symlink it
# to storage on your cluster before launching real training jobs.
export RUN_USER="user"
export PROBLEM="icon_lm"
export CKPT_ROOT="/export/nnoorani/FMint_SDE_Coloured_Noise/save/${RUN_USER}/ckpts/${PROBLEM}"

# Pretrained checkpoint stamps or explicit directories.
# Fine-tuning and few-shot evaluation need these values.
export PRETRAIN_CAP_STAMP=""
export PRETRAIN_NOCAP_STAMP=""
export PRETRAIN_CAP_RESTORE_DIR=""
export PRETRAIN_NOCAP_RESTORE_DIR=""
export PRETRAIN_RESTORE_STEP="1000000"

# Optional common fine-tuned checkpoint directories. Per-system values can also
# be supplied with sanitized uppercase system names, for example:
#   export FT_CAP_STOCHASTIC_LORENZ_STAMP="20250815-012805"
#   export FT_NOCAP_STOCHASTIC_LORENZ_STAMP="20250804-003919"
# For Experiment 5 data-size sweeps, add the N value:
#   export FT_NOCAP_STOCHASTIC_LORENZ_N50_STAMP="20250804-003919"
export FT_CAP_RESTORE_DIR=""
export FT_NOCAP_RESTORE_DIR=""
export FT_RESTORE_STEP="2000"

# Dataset sizes for Experiment 5.
export DATA_SIZE_SWEEP="5 50 100 250 500 1000 5000"

# Optional baseline table. The parser can merge this into the generated table.
# Expected columns are flexible, but source/equation/mae/rmse/amd/mad are useful.
export BASELINE_CSV=""
